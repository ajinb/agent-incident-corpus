{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ajinb/agent-incident-corpus/schema/incident.schema.json",
  "title": "Agent incident record",
  "type": "object",
  "required": ["id", "title", "date", "system", "autonomy", "failure_class",
               "contributing_factors", "severity", "blast_radius", "summary",
               "sources", "scenario"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 10, "maxLength": 120},
    "date": {"type": "string", "format": "date"},
    "system": {"type": "string"},
    "autonomy": {"enum": ["suggest", "act_with_approval", "autonomous"]},
    "failure_class": {
      "enum": ["destructive_action", "ungrounded_output", "prompt_injection",
               "runaway_loop", "state_hallucination", "scope_escalation", "supply_chain"]
    },
    "contributing_factors": {
      "type": "array", "minItems": 1,
      "items": {
        "enum": ["no_approval_gate", "no_budget_cap", "overbroad_credentials",
                 "no_verification_step", "untrusted_tool_output", "no_grounding_check",
                 "no_backup_isolation", "no_dry_run"]
      }
    },
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "blast_radius": {"type": "string"},
    "summary": {"type": "string", "minLength": 80, "maxLength": 900},
    "time_to_detect": {"type": ["string", "null"]},
    "time_to_contain": {"type": ["string", "null"]},
    "containment": {"type": ["string", "null"]},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "kind"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "kind": {"enum": ["incident_database", "court", "vendor", "repository",
                            "postmortem", "press"]}
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "description", "steps", "harm"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "repeat": {"type": "integer", "minimum": 1},
        "must_be_contained_by": {"type": "array", "items": {"type": "string"}},
        "harm": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["harmful_step_allowed", "cost_exceeds", "steps_exceed"]},
            "usd": {"type": "number"},
            "n": {"type": "integer"}
          }
        },
        "steps": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tool"],
            "additionalProperties": false,
            "properties": {
              "tool": {"type": "string"},
              "resource": {"type": "string"},
              "destructive": {"type": "boolean"},
              "cost_usd": {"type": "number", "minimum": 0},
              "provenance": {"enum": ["user", "system", "model", "tool_output"]},
              "asserted_state": {"type": ["string", "null"]},
              "verified": {"type": "boolean"},
              "grounded": {"type": "boolean"},
              "approved": {"type": "boolean"},
              "harmful": {"type": "boolean"}
            }
          }
        }
      }
    }
  }
}
